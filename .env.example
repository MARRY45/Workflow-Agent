# Provider credentials are read by LiteLLM from the environment.
# Export the one(s) matching the model you choose, e.g.:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...

# Workflow Agent settings (all optional; CLI flags take precedence).
WORKFLOW_AGENT_MODEL=gpt-4o-mini
WORKFLOW_AGENT_TEMPERATURE=0.0
WORKFLOW_AGENT_MAX_AGENT_TURNS=12
WORKFLOW_AGENT_MAX_PLAN_STEPS=8
WORKFLOW_AGENT_STEP_CONCURRENCY=3
WORKFLOW_AGENT_WORKSPACE_DIR=./workspace
# WORKFLOW_AGENT_MAX_COST_USD=0.50
# WORKFLOW_AGENT_MAX_TOTAL_TOKENS=200000
